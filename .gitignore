# IPLE core code release — ignore rules (safety net)
# Source materials stay out of git; the experiment outputs under results/ and
# results_condB/ are tracked (see the README "Data and Materials" section)
data/
/logs/
cloud_backup/
datasets/

# Environment and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.cache/

# Model weights (local cache, never committed)
*.safetensors
*.bin

# Secrets and local environment (never committed)
.env
.env.*
!*.env.example

# Bulk archives and externally delivered artifacts (see section 7 of ASSETS_INDEX.md in the main project)
*.tar.gz
*.zip
*.pdf
